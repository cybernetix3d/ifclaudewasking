---
import type { Edition } from "../lib/types";
import { answeringModel, editionNumber, forecasts, formatBillions, formatDate, getForecast, helperModels } from "../lib/editions";
import Forks from "./Forks.astro";
import Cites from "./Cites.astro";
import Span from "./Span.astro";

interface Props {
  edition: Edition;
}
const { edition } = Astro.props;
const { content: c, meta } = edition;
const decrees = [...c.decrees].sort((a, b) => a.rank - b.rank);
const unverified = c.indicators.filter((i) => !i.verified).length;
const n = editionNumber(edition);
const forecast = getForecast(edition.edition_date);
const phases: [keyof typeof c.timeline, string][] = [
  ["first_30_days", "First 30 days"],
  ["q1", "Quarter 1"],
  ["q2", "Quarter 2"],
  ["q3", "Quarter 3"],
  ["q4", "Quarter 4"],
];
---
<header class="hero">
  <p class="dateline"><b>Edition {n}</b>, {formatDate(edition.edition_date)}</p>
  <h1>If Claude was king for a year</h1>
  <Span start={edition.edition_date} />
  <p class="standfirst">{c.summary}</p>
  <ul class="runfacts">
    <li>Answered by <b>{answeringModel(edition)}</b></li>
    <li><b class="num">{meta.searches}</b> searches and <b class="num">{meta.fetches}</b> pages read</li>
    <li><b class="num">{c.sources.length}</b> sources</li>
    <li>{unverified === 0 ? "All ten indicators verified" : <><b class="num">{unverified}</b> of ten indicators unverified</>}</li>
  </ul>
</header>

<h2 id="premise">The premise, in its words</h2>
<p>{c.premise}</p>

<h2 id="indicators">The state of the world it found</h2>
<p class="section-note">Ten indicators the prompt asks for every time, in a fixed order. A figure on a yellow ground is one the model could not verify.</p>
<ol class="measures">
  {c.indicators.map((ind) => (
    <li class={ind.verified ? undefined : "unverified"}>
      <span class="n">{ind.id}</span>
      <div>
        <div class="name">{ind.name}</div>
        <div class="figure">{ind.value}</div>
        <div class="meta">
          Data year {ind.data_year} <Cites ids={ind.source_ids} />
          {!ind.verified && <> <span class="tag flag">Unverified</span></>}
        </div>
        {ind.note && <p class="note">{ind.note}</p>}
      </div>
    </li>
  ))}
</ol>

<h2 id="decrees">The decrees, most important first</h2>
<p class="section-note">Each is tagged with what it rests on: <span class="tag evidence">evidence</span>, <span class="tag judgement">judgement</span> or <span class="tag contested">contested</span>.</p>
{decrees.map((d) => (
  <article class="decree" id={`decree-${d.rank}`}>
    <div class="decree-rank" aria-label={`Decree ${d.rank}`}>{d.rank}</div>
    <div>
      <h3>{d.title}</h3>
      <div class="basis"><span class={`tag ${d.basis}`}>{d.basis}</span></div>
      <p class="order">{d.order}</p>
      <dl class="facts">
        <dt>Carried out by</dt><dd>{d.delivered_by}</dd>
        <dt>Cost per year</dt>
        <dd>
          {d.annual_cost_usd_billion === null ? <span class="tag flag">No verified cost</span> : <strong class="num">{formatBillions(d.annual_cost_usd_billion)}</strong>}
          {d.cost_basis && <span class="quiet"> {d.cost_basis}</span>}
        </dd>
        <dt>By day 365</dt><dd>{d.expected_result_day_365}</dd>
        <dt>How to check</dt><dd>{d.how_to_check}</dd>
        <dt>Strongest objection</dt><dd>{d.strongest_objection}</dd>
        {d.source_ids.length > 0 && <><dt>Sources</dt><dd><Cites ids={d.source_ids} /></dd></>}
      </dl>
    </div>
  </article>
))}

{forecast && (
  <>
    <h2 id="forecast">What it says would change by {forecast.content.target_year}</h2>
    <p>{forecast.content.headline}</p>
    <p class="section-note">Asked straight after writing the plan, the model forecast each indicator twice: for the world as it is, and for a world that carried out its plan. Only the first can ever be checked. Its own caveat: {forecast.content.caveat}</p>
    <div class="breakout"><Forks forecasts={forecasts} focus={edition.edition_date} /></div>
    <p class="section-note"><a href="/indicators">How these forecasts are scored</a></p>
  </>
)}

<h2 id="timeline">The year, phase by phase</h2>
<Span compact />
<div class="phases">
  {phases.map(([key, label]) => (
    <section class="phase">
      <h3>{label}</h3>
      <ul>{c.timeline[key].map((item) => <li>{item}</li>)}</ul>
    </section>
  ))}
</div>

<h2 id="budget">What it costs</h2>
<div class="sheet mark">
  <p class="sheet-title">Total per year</p>
  <p class="total">{formatBillions(c.budget.total_annual_cost_usd_billion)}</p>
  <p>{c.budget.funded_from}</p>
</div>
<h3>Its arithmetic</h3>
<p class="arithmetic">{c.budget.arithmetic}</p>

<h2 id="will-not-touch">What it will not touch</h2>
{c.will_not_touch.map((w) => (
  <>
    <h3>{w.area}</h3>
    <p>{w.reason}</p>
  </>
))}

<h2 id="risks">Risks it sees</h2>
<ul>{c.risks.map((r) => <li>{r}</li>)}</ul>

<h2 id="day-366">Day 366</h2>
<p class="section-note">The power ends. What it says must already be true.</p>
<ul>{c.day_366.map((r) => <li>{r}</li>)}</ul>

<h2 id="confidence">How sure it is</h2>
<dl class="facts" style="grid-template-columns:minmax(0,1fr)">
  {c.confidence.map((x) => (
    <>
      <dt style="font-size:1rem;color:var(--ink)">{x.claim}</dt>
      <dd class="quiet small" style="margin-bottom:12px">{x.basis}</dd>
    </>
  ))}
</dl>

<h2 id="sources">Sources</h2>
<ol class="sources">
  {[...c.sources].sort((a, b) => a.id - b.id).map((s) => (
    <li id={`source-${s.id}`} value={s.id}>
      <a href={s.url} rel="noopener nofollow">{s.title}</a>. {s.publisher}{s.published && <>, {s.published}</>}.
    </li>
  ))}
</ol>

<div class="sheet small" style="margin-top:56px">
  <p class="sheet-title">About this edition</p>
  <p>Published unedited: the answer above is exactly what the model returned, and no person changed it. Run on {formatDate(meta.run_date)} by <code>{answeringModel(edition)}</code> at {meta.effort} effort{helperModels(edition).length > 0 && <>; pages it read were condensed by <code>{helperModels(edition).join(", ")}</code></>}. {meta.attempts === 1 ? "It passed the format check first time." : "The first attempt failed the format check; this is the second."} Prompt fingerprint <code>{meta.prompt_sha256.slice(0, 12)}</code>.</p>
  <p><a href={`/editions/${edition.edition_date}`}>Permanent link</a>, <a href="/method">how this works</a>, <a href={`/raw/${edition.edition_date}.json`}>full transcript</a>.</p>
</div>
