---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "Every three months, Claude is made king of the world for a year and asked for its plan. The answers are published unedited.", wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const nav = [
  ["/", "Latest"],
  ["/editions", "Editions"],
  ["/compare", "Compare"],
  ["/indicators", "Indicators"],
  ["/method", "Method"],
];
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === "If Claude Was King" ? title : `${title} · If Claude Was King`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <div class="bar">
      <div class="bar-in">
        <a class="brand" href="/">If Claude Was King</a>
        <nav class="nav" aria-label="Site">
          {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        </nav>
        <button class="theme-btn" type="button" id="theme-btn" aria-label="Switch colour theme">Theme</button>
      </div>
    </div>
    <div class="page">
      <main class={wide ? "wide" : undefined}>
        <slot />
      </main>
    </div>
    <footer class="site">
      <p>An independent experiment. Not affiliated with or endorsed by Anthropic. Generated by an AI model as a thought experiment. Not advice.</p>
    </footer>
    <script is:inline>
      (() => {
        const btn = document.getElementById("theme-btn");
        const root = document.documentElement;
        const dark = () => root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        const label = () => { btn.textContent = dark() ? "Light mode" : "Dark mode"; };
        label();
        btn.addEventListener("click", () => {
          const next = dark() ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("theme", next); } catch {}
          label();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", label);
      })();
    </script>
  </body>
</html>
