---
import Base from "../../layouts/Base.astro";
import { answeringModel, editionNumber, editions, formatDate, formatBillions } from "../../lib/editions";
---
<Base title="All editions">
  <header class="hero">
    <h1>Every edition</h1>
    <p class="standfirst">The same prompt, answered every three months by the newest Claude model, with fresh research each time. Newest first.</p>
  </header>
  {editions.length === 0 ? (
    <div class="sheet mark"><p>No editions yet. The first runs on the next scheduled date.</p></div>
  ) : (
    <ol class="register">
      {editions.map((e) => (
        <li>
          <a href={`/editions/${e.edition_date}`}>
            <div>
              <div class="r-date">{formatDate(e.edition_date)}</div>
              <div class="r-meta">Edition {editionNumber(e)}</div>
            </div>
            <div>
              <div class="r-sum">{e.content.summary}</div>
              <div class="r-meta">{answeringModel(e)}, {e.content.decrees.length} decrees, {formatBillions(e.content.budget.total_annual_cost_usd_billion)} a year</div>
            </div>
          </a>
        </li>
      ))}
    </ol>
  )}
  <p class="quiet small" style="margin-top:32px">Before the series there was <a href="/edition-zero/seven-weeks-as-king.html">edition zero</a>, a one-off answer to a different question. It is kept for the record and is not counted here.</p>
</Base>
