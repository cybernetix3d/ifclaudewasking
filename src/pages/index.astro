---
import Base from "../layouts/Base.astro";
import EditionView from "../components/EditionView.astro";
import { latest, config } from "../lib/editions";
---
<Base title="If Claude Was King">
  {latest ? (
    <EditionView edition={latest} />
  ) : (
    <header class="hero">
      <h1>If Claude was king for a year</h1>
      <p class="standfirst">Every {config.cadence_months} months, Anthropic's latest Claude model is made king of the world for one year and asked for its plan. Each answer is published here unedited, so you can watch the plan change over time.</p>
      <div class="sheet mark">
        <p>The first edition has not been published yet. Read <a href="/method">how it works</a>, including the full prompt and <a href="/edition-zero/seven-weeks-as-king.html">edition zero</a>, the one-off answer that started it.</p>
      </div>
    </header>
  )}
</Base>
